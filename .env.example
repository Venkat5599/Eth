# ---- Chains ----
ARB_SEPOLIA_RPC=https://sepolia-rollup.arbitrum.io/rpc
BASE_SEPOLIA_RPC=https://sepolia.base.org
ETH_SEPOLIA_RPC=https://rpc.sepolia.org

# Deployer / agent key (testnet only, never commit a real one)
PRIVATE_KEY=0x...

# ---- Deployed contracts (filled after deploy) ----
COBRA_CONTRACT=0x...
CREDIT_VERIFIER=0x...
USDC_TEST=0x...

# ---- AI agent (collections nudges) ----
# OpenAI-compatible endpoint. Default DeepSeek; falls back to templates if unset.
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=sk-...
AGENT_POLL_SECONDS=20

# ---- Factoring / credit gate ----
ADVANCE_BPS=500          # 5% factoring fee
ADVANCE_MIN_SCORE=65     # credit-score threshold the zk proof must clear (== contract)

# ---- Collections nudge channel (email demo) ----
RESEND_API_KEY=re_...           # optional; agent logs to console if unset
NUDGE_FROM=cobra@yourdomain.dev

# ---- Rails (sandbox) ----
BITSO_API_KEY=                  # Bitso Business sandbox
BITSO_API_SECRET=
BITSO_BASE_URL=https://sandbox.bitso.com/api/v3
ETHERFUSE_API_KEY=              # MXNe swap (sandbox/mock if empty)
ETHERFUSE_BASE_URL=https://api.sandbox.etherfuse.com

# ---- Pay-in (x402, Base Sepolia) ----
X402_FACILITATOR_URL=           # x402 facilitator; mock if empty
X402_PAY_TO=0x...               # address that receives USDC pay-in

# ---- App ----
NEXT_PUBLIC_AGENT_URL=http://localhost:8787   # the Bun agent API (prod: VPS IP/domain)
NEXT_PUBLIC_COBRA_CONTRACT=0x...
NEXT_PUBLIC_CHAIN_ID=421614     # Arbitrum Sepolia
